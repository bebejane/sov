{
	"name": "sov",
	"main": "expo-router/entry",
	"version": "1.0.8",
	"scripts": {
		"dev": "pnpm run codegen & expo start --ios",
		"dev:android": "pnpm run codegen & expo start --android --tunnel",
		"ios": "expo run:ios",
		"ios:device": "expo run:ios --device",
		"android": "expo run:android",
		"android:device": "expo run:android --device",
		"web": "expo start --web",
		"test": "jest --watchAll",
		"prebuild": "pnpx expo prebuild --clean",
		"build:local": "eas build --local --profile production --platform ios",
		"build:local:android": "eas build --local --profile production --platform android",
		"build:ios": "EXPO_APPLE_TEAM_ID=85KU5LMS57 eas build --profile production --platform ios",
		"build:android": "eas build --profile production --platform android --clear-cache",
		"submit:ios": "eas submit --platform ios",
		"codegen": "graphql-codegen --watch"
	},
	"jest": {
		"preset": "jest-expo"
	},
